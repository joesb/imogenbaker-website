---
layout: base.njk
---

{% if image %}
<div class="index-site--image-main content-canvas">
  {% figure "index-site--image-main--figure content-canvas-item-full" %}
    {# {% image image.path, image.alt, 'index-site--image-main--image image-obj-cover image-max-height-100vh','index-site--image-main--picture' %} #}
    {% Markdown true %}![{{ image.alt }}]({{ image.path }}){.index-site--image-main--image .image-obj-cover .image-max-height-100vh}{% endMarkdown %}
  {% endfigure %}
</div>
{% endif %}

{% if meta.slogan %}
<div class="index-site--slogan">
    <p class="index-site--slogan--text">{{ meta.slogan }}</p>
    <p class="index-site--slogan--contact"><a href="/contact/" class="index-site--slogan--link button">Contact us</a></p>
</div>
{% endif %}

{# Title bar #}
<div class="content-canvas">
  {% include "layouts/components/title-bar.njk" %}
</div>

{# Main page content #}
<div class="content-canvas">
  {{ content | safe }}
</div>